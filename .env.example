# ─────────────────────────────────────────────────────────────────────────────
# Root environment — copy to .env and fill in your values.
# These are used by scripts/deploy-remote.sh and local tooling.
# ─────────────────────────────────────────────────────────────────────────────

# TODO: your Cloudflare account ID (dash.cloudflare.com → right sidebar)
CLOUDFLARE_ACCOUNT_ID=CHANGE_ME

# Deployed Worker URL — written automatically by scripts/deploy-remote.sh
# after a successful deploy. You can also set it manually.
# Format: https://pdc-{client-slug}.{account}.workers.dev
WORKER_URL=CHANGE_ME

# Twilio credentials — set on the Worker via `wrangler secret put` (not in .env)
# See workers/api/.dev.vars.example for the full list of secrets.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
