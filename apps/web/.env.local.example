# Remote API — written automatically by `pnpm deploy:remote` from the repo root.
# You can also set this manually after deploying the Worker.
# Format: https://pdc-{client-slug}.{account}.workers.dev
NEXT_PUBLIC_API_URL=CHANGE_ME

# Local Worker (optional — for local dev without a deployed Worker)
# NEXT_PUBLIC_API_URL=http://localhost:8787
